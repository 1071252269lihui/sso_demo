# 统一换行符配置
# 参考: https://help.github.com/articles/dealing-with-line-endings/

# Maven wrapper
/mvnw text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# 自动检测文本文件并规范化为 LF
* text=auto eol=lf

# Java 源代码
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 前端源代码
*.vue text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

# 配置文件
*.md text eol=lf
*.gitignore text eol=lf
*.http text eol=lf

# Shell 脚本（必须使用 LF）
*.sh text eol=lf

# 二进制文件（不转换）
*.class binary
*.jar binary
*.war binary
*.zip binary
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
